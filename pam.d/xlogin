# PAM configuration for xlogin
# Explicit stack — pam_elogind.so is optional: registers the session with
# elogind when it is present so applications can query session ownership.
# Silently skipped on systems where elogind is not installed.
auth     required    pam_unix.so
account  required    pam_unix.so
session  required    pam_unix.so
session  optional    pam_limits.so
session  optional    pam_elogind.so
